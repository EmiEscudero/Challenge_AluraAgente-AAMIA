# Rutas y recuperación
DOCS_DIR=docs
INDEX_DIR=data/index
LOGS_DIR=logs
CHUNK_SIZE=1400
CHUNK_OVERLAP=220
MIN_PAGE_CHARS=60
TOP_K=5
CANDIDATE_K=24
RETRIEVAL_THRESHOLD=1.0

# Modo listo para funcionar sin credenciales: extractive | openai | oci
LLM_PROVIDER=extractive

# OpenAI Responses API (opcional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# OPENAI_BASE_URL=

# OCI Generative AI Responses API (opcional y recomendado para el demo en OCI)
OCI_GENAI_API_KEY=
OCI_GENAI_REGION=us-chicago-1
OCI_GENAI_PROJECT=
OCI_GENAI_MODEL=openai.gpt-oss-120b

# Privacidad: false guarda hashes y metadatos, nunca preguntas/respuestas completas
LOG_CONTENT=false
APP_ENV=development
